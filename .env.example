# LeaveTrack — environment variables (placeholder values only; never commit real secrets)

# Plain Postgres connection string used by scripts/migrate.ts, scripts/seed.ts,
# scripts/accrual-job.ts, and all server-side queries (src/lib/db.ts).
# On Vercel, set this in Project → Settings → Environment Variables (production).
DATABASE_URL=postgres://user:password@host:5432/database

# Random secret sent as `Authorization: Bearer <CRON_SECRET>` by the Vercel Cron
# invocation of /api/jobs/accrual. Generate with `openssl rand -hex 32`. If
# unset, the accrual endpoint falls back to the hr_admin session gate only.
CRON_SECRET=change-me

# Google OAuth (Sign in with Google). Create credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client, Web application)
# and authorize this redirect URI:
#   <app origin>/api/auth/google/callback   (e.g. http://localhost:3000/api/auth/google/callback)
# 'Continue with Google' stays hidden and the endpoints return CONFIGURATION_ERROR
# while either value is unset; email/password mock auth is unaffected.
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret

# Local development runs on port 3000 (npm run dev / dev:cron). Real values for the
# variables above go in .env.local (auto-loaded by Next.js and vercel-local-cron,
# gitignored). This file keeps placeholders only.