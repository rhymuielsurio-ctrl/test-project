{
  "name": "leave-track",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:migrate": "tsx scripts/migrate.ts",
    "db:setup": "npm run db:migrate && npm run seed",
    "dev": "next dev --turbopack",
    "dev:cron": "vercel-local-cron run -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "prepare": "husky",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.30.0",
    "eslint-config-next": "16.3.3",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vercel-local-cron": "^0.1.2"
  }
}
