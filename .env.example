# LeaveTrack — environment variables (placeholder values only; never commit real secrets)

# Plain Postgres connection string used by scripts/migrate.ts, scripts/seed.ts,
# scripts/accrual-job.ts, and all server-side queries (src/lib/db.ts).
# On Vercel, set this in Project → Settings → Environment Variables (production).
DATABASE_URL=postgres://user:password@host:5432/database

# Random secret sent as `Authorization: Bearer <CRON_SECRET>` by the Vercel Cron
# invocation of /api/jobs/accrual. Generate with `openssl rand -hex 32`. If
# unset, the accrual endpoint falls back to the hr_admin session gate only.
CRON_SECRET=change-me